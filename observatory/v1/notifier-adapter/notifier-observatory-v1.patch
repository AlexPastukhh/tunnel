+    }
+
+    refreshChat();
+    return {
+      noteArmed, check, resetForNavigation: refreshChat, pairCurrent, unpairCurrent,
+      isPaired: () => Boolean(pairing),
+      getLatestSequence: () => latestSequence
+    };
+  }
+
+  return { createObservatoryCompletionBridge, currentChatId, validatePairing };
+});
